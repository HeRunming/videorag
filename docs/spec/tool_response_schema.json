{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:av-trace:schema:tool-response:0.2.0",
  "title": "AV-TRACE tool response envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "episode_id",
    "request_id",
    "step_index",
    "tool",
    "status",
    "cost_charged",
    "cost_used_total",
    "cost_remaining",
    "backend_version",
    "results",
    "error",
    "response_hash"
  ],
  "properties": {
    "protocol_version": {"const": "0.2.0"},
    "episode_id": {"$ref": "#/$defs/id"},
    "request_id": {"$ref": "#/$defs/id"},
    "step_index": {"type": "integer", "minimum": 0},
    "tool": {
      "enum": [
        "search_visual",
        "search_speech",
        "search_ambient_audio",
        "inspect_clip",
        "read_transcript",
        "get_channel_status"
      ]
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "channel_unavailable",
        "timeout",
        "invalid_request",
        "budget_exhausted",
        "rate_limited",
        "not_found"
      ]
    },
    "cost_charged": {"type": "number", "minimum": 0},
    "cost_used_total": {"type": "number", "minimum": 0},
    "cost_remaining": {"type": "number", "minimum": 0},
    "backend_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "results": {
      "type": "array",
      "items": {"$ref": "#/$defs/result"}
    },
    "error": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/error"}
      ]
    },
    "response_hash": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"status": {"enum": ["ok", "partial"]}},
        "required": ["status"]
      },
      "then": {"properties": {"error": {"type": "null"}}}
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "channel_unavailable",
              "timeout",
              "invalid_request",
              "budget_exhausted",
              "rate_limited",
              "not_found"
            ]
          }
        },
        "required": ["status"]
      },
      "then": {"properties": {"error": {"$ref": "#/$defs/error"}}}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_s", "end_s"],
      "properties": {
        "start_s": {"type": "number", "minimum": 0},
        "end_s": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "retryable", "message", "retry_after_step"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
        "retryable": {"type": "boolean"},
        "message": {"type": "string", "maxLength": 240},
        "retry_after_step": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "search_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "result_id", "interval", "score", "preview"],
      "properties": {
        "result_type": {"const": "search_pointer"},
        "result_id": {"$ref": "#/$defs/id"},
        "interval": {"$ref": "#/$defs/interval"},
        "score": {"type": "number"},
        "preview": {"type": "string", "maxLength": 1000}
      }
    },
    "observation_result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result_type",
        "observation_id",
        "interval",
        "modalities",
        "payload",
        "payload_hash"
      ],
      "properties": {
        "result_type": {"const": "observation"},
        "observation_id": {"$ref": "#/$defs/id"},
        "interval": {"$ref": "#/$defs/interval"},
        "modalities": {
          "type": "array",
          "items": {"enum": ["vision", "speech", "ambient"]},
          "minItems": 1,
          "uniqueItems": true
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        },
        "payload_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "channel_status_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result_type", "channels"],
      "properties": {
        "result_type": {"const": "channel_status"},
        "channels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "retryable"],
            "properties": {
              "status": {"enum": ["available", "degraded", "unavailable"]},
              "retryable": {"type": "boolean"}
            }
          }
        }
      }
    },
    "result": {
      "oneOf": [
        {"$ref": "#/$defs/search_result"},
        {"$ref": "#/$defs/observation_result"},
        {"$ref": "#/$defs/channel_status_result"}
      ]
    }
  }
}

