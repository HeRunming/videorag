{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:av-trace:schema:semantic-av-source-prescreen-inventory:1.0.0",
  "title": "AV-TRACE semantic A/V source-prescreen inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "inventory_id",
    "inventory_status",
    "sources",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "semantic_av_source_prescreen_inventory"},
    "inventory_id": {"$ref": "#/$defs/id"},
    "inventory_status": {
      "enum": ["PORTABLE_BLANK_FIXTURE", "FROZEN_NONSEMANTIC_SOURCE_INVENTORY"]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/source"}
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_group_id",
        "duration_s",
        "source_content_sha256",
        "adapter_reference",
        "media_included",
        "semantic_metadata_included"
      ],
      "properties": {
        "source_id": {"$ref": "#/$defs/id"},
        "source_group_id": {"$ref": "#/$defs/id"},
        "duration_s": {"type": "number", "exclusiveMinimum": 0},
        "source_content_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_reference": {"type": "string", "minLength": 1},
        "media_included": {"const": false},
        "semantic_metadata_included": {"const": false}
      }
    }
  }
}
