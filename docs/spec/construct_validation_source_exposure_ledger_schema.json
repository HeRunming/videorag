{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:av-trace:schema:construct-validation-source-exposure-ledger:1.0.0",
  "title": "AV-TRACE source-group reviewer exposure ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "packet_id",
    "ledger_status",
    "source_groups",
    "pre_distribution_snapshot",
    "pre_distribution_snapshot_sha256",
    "review_events",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "record_type": {
      "const": "construct_validation_source_exposure_ledger"
    },
    "packet_id": {
      "$ref": "#/$defs/id"
    },
    "ledger_status": {
      "const": "OPEN_APPEND_ONLY"
    },
    "source_groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source_group"
      }
    },
    "pre_distribution_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "captured_at",
        "events"
      ],
      "properties": {
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    "pre_distribution_snapshot_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "review_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "role": {
      "enum": [
        "question_claim_author_or_verifier",
        "blind_alternative_evidence_finder",
        "validator_a",
        "validator_b",
        "adjudicator",
        "blind_post_adjudication_saturation_auditor",
        "external_prior_work"
      ]
    },
    "exposure_category": {
      "enum": [
        "source_content",
        "frozen_question",
        "preferred_evidence",
        "machine_ranks_or_confidence",
        "validator_decisions",
        "adjudication_decisions",
        "accepted_ses"
      ]
    },
    "source_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_group_id",
        "source_ids",
        "family_ids"
      ],
      "properties": {
        "source_group_id": {
          "$ref": "#/$defs/id"
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "family_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "sequence",
        "previous_event_sha256",
        "reviewer_id",
        "source_group_id",
        "family_id",
        "role",
        "exposure_categories",
        "exposed_at",
        "recorded_at",
        "artifact_references",
        "notes",
        "event_sha256"
      ],
      "properties": {
        "event_id": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "previous_event_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer_id": {
          "$ref": "#/$defs/id"
        },
        "source_group_id": {
          "$ref": "#/$defs/id"
        },
        "family_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "exposure_categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/exposure_category"
          },
          "uniqueItems": true
        },
        "exposed_at": {
          "type": "string",
          "format": "date-time"
        },
        "recorded_at": {
          "type": "string",
          "format": "date-time"
        },
        "artifact_references": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        },
        "event_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
