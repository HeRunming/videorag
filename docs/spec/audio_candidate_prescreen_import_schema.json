{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:av-trace:schema:audio-candidate-prescreen-import:1.0.0",
  "title": "AV-TRACE audio-candidate prescreen import report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "packet_id",
    "form_id",
    "candidate_code",
    "source_id",
    "source_group_id",
    "completion_status",
    "authoring_eligibility",
    "readiness_token",
    "exposure_recorded",
    "construct_ledger_bridge_required",
    "blind_finder_eligible",
    "saturation_auditor_eligible",
    "necessity_assigned",
    "minimality_assigned",
    "h1_assigned",
    "h2_assigned",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "record_type": {"const": "audio_candidate_prescreen_import"},
    "packet_id": {"type": "string", "minLength": 1},
    "form_id": {"type": "string", "minLength": 1},
    "candidate_code": {"type": "string", "minLength": 1},
    "source_id": {"type": "string", "minLength": 1},
    "source_group_id": {"type": "string", "minLength": 1},
    "completion_status": {"enum": ["incomplete", "valid"]},
    "authoring_eligibility": {
      "enum": ["UNDECIDED", "READY", "REPAIR", "NO_GO"]
    },
    "readiness_token": {
      "enum": [
        "AUDIO_CANDIDATE_PRESCREEN_PACKETS_READY",
        "AUDIO_CANDIDATE_PRESCREEN_PACKETS_REPAIR",
        "AUDIO_CANDIDATE_PRESCREEN_PACKETS_NO_GO"
      ]
    },
    "exposure_recorded": {"type": "boolean"},
    "construct_ledger_bridge_required": {"const": true},
    "blind_finder_eligible": {"const": false},
    "saturation_auditor_eligible": {"const": false},
    "necessity_assigned": {"const": false},
    "minimality_assigned": {"const": false},
    "h1_assigned": {"const": false},
    "h2_assigned": {"const": false},
    "errors": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    }
  }
}
