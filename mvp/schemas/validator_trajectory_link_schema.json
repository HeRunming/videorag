{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:av-trace:schema:validator-trajectory-link:1.0.0",
  "title": "AV-TRACE validator trajectory linkage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "link_id",
    "validator_id",
    "family_id",
    "family_annotation_version",
    "episode_id",
    "state_role",
    "trajectory_path",
    "trajectory_id",
    "trajectory_hash",
    "family_path",
    "family_hash",
    "backend_version",
    "backend_manifest_hash",
    "index_version",
    "index_hash",
    "source_manifest_hash",
    "intervention_manifest_hash",
    "search_plan_id",
    "trigger_type",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "link_id": {"$ref": "#/$defs/id"},
    "validator_id": {"$ref": "#/$defs/id"},
    "family_id": {"$ref": "#/$defs/id"},
    "family_annotation_version": {"type": "string", "minLength": 1},
    "episode_id": {"$ref": "#/$defs/id"},
    "state_role": {"enum": ["CLEAN", "BLOCKED", "RESTORED"]},
    "trajectory_path": {"$ref": "#/$defs/path"},
    "trajectory_id": {"$ref": "#/$defs/id"},
    "trajectory_hash": {"$ref": "#/$defs/hash"},
    "family_path": {"$ref": "#/$defs/path"},
    "family_hash": {"$ref": "#/$defs/hash"},
    "backend_version": {"type": "string", "minLength": 1},
    "backend_manifest_hash": {"$ref": "#/$defs/hash"},
    "index_version": {"type": "string", "minLength": 1},
    "index_hash": {"$ref": "#/$defs/hash"},
    "source_manifest_hash": {"$ref": "#/$defs/hash"},
    "intervention_manifest_hash": {"$ref": "#/$defs/hash"},
    "search_plan_id": {"$ref": "#/$defs/id"},
    "trigger_type": {"enum": ["none", "fixed_call_index", "get_channel_status"]},
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"}
  }
}
