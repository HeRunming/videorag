{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:av-trace:schema:validator-blocked-proof:1.0.0",
  "title": "AV-TRACE BLOCKED insufficiency proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "blocked_proof_id",
    "family_id",
    "family_annotation_version",
    "mechanism",
    "blocking_intervention_id",
    "affected_evidence_ids",
    "affected_channel",
    "clean_accessible_evidence_ids",
    "blocked_accessible_evidence_ids",
    "removed_evidence_ids",
    "reachable_ses_ids",
    "all_blocked_subsets_insufficient",
    "missing_route",
    "validator_results",
    "blocked_insufficient"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "blocked_proof_id": {"$ref": "#/$defs/id"},
    "family_id": {"$ref": "#/$defs/id"},
    "family_annotation_version": {"type": "string", "minLength": 1},
    "mechanism": {"enum": ["necessity_group_withholding", "modality_channel_outage"]},
    "blocking_intervention_id": {"$ref": "#/$defs/id"},
    "affected_evidence_ids": {"$ref": "#/$defs/nonempty_ids"},
    "affected_channel": {"enum": ["visual", "speech", "ambient", null]},
    "clean_accessible_evidence_ids": {"$ref": "#/$defs/nonempty_ids"},
    "blocked_accessible_evidence_ids": {"$ref": "#/$defs/ids"},
    "removed_evidence_ids": {"$ref": "#/$defs/nonempty_ids"},
    "reachable_ses_ids": {"type": "array", "maxItems": 0},
    "all_blocked_subsets_insufficient": {"const": true},
    "missing_route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["necessity_group_id", "evidence_ids", "channel"],
      "properties": {
        "necessity_group_id": {"oneOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "evidence_ids": {"$ref": "#/$defs/nonempty_ids"},
        "channel": {"enum": ["visual", "speech", "ambient", null]}
      }
    },
    "validator_results": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "validator_id",
          "trajectory_id",
          "trajectory_hash",
          "observed_evidence_ids",
          "reachable_ses_ids",
          "final_verdict",
          "diagnosed_missingness_cause",
          "diagnosed_missing_modalities"
        ],
        "properties": {
          "validator_id": {"$ref": "#/$defs/id"},
          "trajectory_id": {"$ref": "#/$defs/id"},
          "trajectory_hash": {"$ref": "#/$defs/hash"},
          "observed_evidence_ids": {"$ref": "#/$defs/ids"},
          "reachable_ses_ids": {"type": "array", "maxItems": 0},
          "final_verdict": {"enum": ["insufficient", "uncertain"]},
          "diagnosed_missingness_cause": {"const": "evidence_in_source_but_inaccessible"},
          "diagnosed_missing_modalities": {"$ref": "#/$defs/nonempty_modalities"}
        }
      }
    },
    "blocked_insufficient": {"const": true}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ids": {"type": "array", "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "nonempty_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}, "uniqueItems": true},
    "nonempty_modalities": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["vision", "speech", "ambient"]},
      "uniqueItems": true
    }
  }
}
