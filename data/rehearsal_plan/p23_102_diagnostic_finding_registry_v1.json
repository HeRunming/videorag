        "stratum_value",
        "focal_system",
        "comparator_system",
        "eligible_paired_families",
        "delta_supported_answer",
        "delta_supported_answer_ci95",
        "delta_tool_cost",
        "delta_tool_cost_ci95",
        "incremental_cost_per_supported_answer",
        "objective_classification"
      ],
      "permitted_wording": "Within the named P23_102 development stratum, the focal system had the preregistered descriptive cost-benefit classification relative to the comparator.",
      "prohibited_wording": "A globally cost-effective system or a modality/hop generalization."
    }
