          "V+S+A"
        ]
      },
      "estimands": {
        "delta_supported_answer": "mean_paired(supported_answer_endpoint_focal - supported_answer_endpoint_comparator)",
        "delta_tool_cost": "mean_paired(tool_cost_focal - tool_cost_comparator)",
        "incremental_cost_per_supported_answer": "delta_tool_cost / delta_supported_answer when delta_supported_answer > 0; otherwise explicit null_or_infinite classification"
      },
      "objective_classification": {
        "STRICT_DOMINANCE": "delta_supported_answer > 0 and delta_tool_cost <= 0",
        "BENEFICIAL_TRADEOFF": "delta_supported_answer > 0 and delta_tool_cost > 0",
        "STRICTLY_DOMINATED": "delta_supported_answer < 0 and delta_tool_cost >= 0",
        "COST_SAVING_WITH_SUCCESS_LOSS": "delta_supported_answer < 0 and delta_tool_cost < 0",
        "COST_INCREASE_NO_SUCCESS_GAIN": "delta_supported_answer == 0 and delta_tool_cost > 0",
        "COST_SAVING_NO_SUCCESS_CHANGE": "delta_supported_answer == 0 and delta_tool_cost < 0",
        "NO_DIRECTIONAL_DIFFERENCE": "delta_supported_answer == 0 and delta_tool_cost == 0"
      },
      "objective_decision_rule": {
        "INSUFFICIENT_N": "eligible_paired_families_in_stratum < 5",
        "OBSERVED_DESCRIPTIVE": "eligible_paired_families_in_stratum >= 5 and an objective_classification is assigned",
