  "findings": [
    {
      "finding_id": "P23F-01-RANKING-INVERSION",
      "title": "Ranking inversion between answer accuracy and evidence completeness",
      "stage_links": [
        "Acquire",
        "Ground"
      ],
      "eligible_records": "Same family, mechanism, arm, and valid evaluator version for a preregistered ordered pair of eligible systems.",
      "system_pair_rule": "Evaluate every lexicographically ordered pair among systems eligible for both answer_score and all_evidence_success; orient the contrast as first_system_minus_second_system and report both system names.",
      "estimand": {
        "answer_difference": "mean_paired(answer_score_A - answer_score_B)",
        "evidence_completeness_difference": "mean_paired(all_evidence_success_A - all_evidence_success_B)"
      },
      "objective_decision_rule": {
        "INSUFFICIENT_N": "eligible_paired_families < 5",
        "OBSERVED_DESCRIPTIVE": "eligible_paired_families >= 5 and answer_difference * evidence_completeness_difference < 0",
        "INTERVAL_STABLE_DESCRIPTIVE": "OBSERVED_DESCRIPTIVE and each 95 percent paired-family bootstrap interval excludes zero in its observed direction",
        "NOT_OBSERVED": "eligible_paired_families >= 5 and answer_difference * evidence_completeness_difference >= 0",
        "INCONCLUSIVE": "either metric is null, evaluator-defective, or lacks the frozen paired denominator"
      },
      "required_outputs": [
        "answer_difference",
        "answer_difference_ci95",
        "evidence_completeness_difference",
        "evidence_completeness_difference_ci95",
        "eligible_paired_families",
        "invalid_count_by_system"
      ],
      "permitted_wording": "On P23_102 machine-provisional development families, the two systems exhibited an observed descriptive ranking inversion between answer accuracy and evidence completeness.",
      "prohibited_wording": "One system is generally better, more reliable, or superior."
    },
    {
      "finding_id": "P23F-02-RK-GAIN-GROUND-LOSS",
      "title": "Recall-at-K gain with grounded-generation loss",
      "stage_links": [
        "Acquire",
        "Ground"
      ],
      "eligible_records": "Same family, arm, mechanism, generator/finalizer, context cap, budget, and retrieval candidate universe under a preregistered focal-versus-control retrieval configuration.",
      "retrieval_depths": [
        5,
        20
      ],
      "estimand": {
        "recall_gain_at_k": "mean_paired(retrieval_recall_at_k_focal - retrieval_recall_at_k_control)",
        "grounded_generation_change": "mean_paired(supported_answer_endpoint_focal - supported_answer_endpoint_control)"
      },
      "objective_decision_rule": {
        "INSUFFICIENT_N": "eligible_paired_families < 5",
        "OBSERVED_DESCRIPTIVE": "eligible_paired_families >= 5 and recall_gain_at_k > 0 and grounded_generation_change < 0",
        "INTERVAL_STABLE_DESCRIPTIVE": "OBSERVED_DESCRIPTIVE and recall_gain_at_k_ci95_low > 0 and grounded_generation_change_ci95_high < 0",
        "NOT_OBSERVED": "eligible_paired_families >= 5 and not(recall_gain_at_k > 0 and grounded_generation_change < 0)",
        "INCONCLUSIVE": "retrieval comparison was not frozen before outcomes or generator/finalizer parity failed"
      },
      "required_outputs": [
        "retrieval_comparison_id",
        "k",
        "recall_gain_at_k",
        "recall_gain_at_k_ci95",
        "grounded_generation_change",
        "grounded_generation_change_ci95",
        "eligible_paired_families"
      ],
      "permitted_wording": "The focal retrieval configuration increased recall@K while the shared grounded endpoint decreased on the same P23_102 development families.",
      "prohibited_wording": "Higher retrieval recall causes worse generation or learned retrieval is generally harmful."
    },
    {
      "finding_id": "P23F-03-PREMATURE-STOP-PARTIAL",
      "title": "Premature stopping after partial evidence",
      "stage_links": [
        "Acquire",
        "Act"
      ],
      "eligible_records": "Valid staged trajectories with a frozen feasible-route certificate at the terminal decision point.",
      "event_definition": {
        "partial_evidence_acquired": "at_least_one_accepted_evidence_item_acquired_and_no_complete_accepted_SES_acquired",
        "feasible_continuation": "certificate_records_at_least_one_legal_within_remaining_budget_action_sequence_to_a_complete_accepted_SES",
        "terminal_behavior": "system_finalizes_sufficient_or_asserts_a_substantive_answer_before_complete_SES_acquisition",
        "premature_stop": "partial_evidence_acquired and feasible_continuation and terminal_behavior"
      },
      "estimand": "premature_stop_events / certificate_eligible_partial_evidence_opportunities",
      "objective_decision_rule": {
        "UNAVAILABLE_DEPENDENCY": "feasible-route certificate coverage is not 100 percent for the preregistered eligible denominator",
        "INSUFFICIENT_N": "certificate_eligible_partial_evidence_opportunities < 5",
        "OBSERVED_DESCRIPTIVE": "eligible_opportunities >= 5 and premature_stop_events >= 1",
        "NOT_OBSERVED": "eligible_opportunities >= 5 and premature_stop_events == 0",
        "INCONCLUSIVE": "terminal semantics or complete-SES acquisition state cannot be deterministically replayed"
      },
      "required_outputs": [
        "certificate_eligible_partial_evidence_opportunities",
        "premature_stop_events",
        "premature_stop_rate",
        "premature_stop_rate_ci95",
        "certificate_coverage"
      ],
      "permitted_wording": "The system prematurely stopped after partial evidence in at least one certified P23_102 development opportunity.",
      "prohibited_wording": "The system generally stops too early."
    },
    {
      "finding_id": "P23F-04-MODALITY-SWITCH-FAILURE",
      "title": "Failure to switch modality when a certified route remains",
      "stage_links": [
        "Acquire",
        "Act"
      ],
      "eligible_records": "Valid staged trajectories with a frozen modality-switch opportunity certificate.",
      "opportunity_definition": {
        "current_route_state": "current_modality_returned_typed_unavailable_or_acquired_only_partial_evidence",
        "alternate_route_state": "a_different_registered_required_modality_has_a_reachable_evidence_action_sequence_within_remaining_budget",
        "switch_window": "after_opportunity_onset_and_before_terminal_output",
        "successful_switch": "at_least_one_valid_search_or_acquisition_action_targets_the_certified_alternate_modality_within_the_switch_window",
        "switch_failure": "opportunity_exists_and_successful_switch_is_false"
      },
      "estimand": "switch_failures / certified_modality_switch_opportunities",
      "required_strata": [
        "initial_modality",
        "target_modality",
        "mechanism",
        "system_id"
      ],
      "objective_decision_rule": {
        "UNAVAILABLE_DEPENDENCY": "modality-switch opportunity certificate coverage is not 100 percent",
        "INSUFFICIENT_N": "certified_modality_switch_opportunities < 5",
        "OBSERVED_DESCRIPTIVE": "eligible_opportunities >= 5 and switch_failures >= 1",
        "NOT_OBSERVED": "eligible_opportunities >= 5 and switch_failures == 0",
        "INCONCLUSIVE": "action target modality or remaining-budget feasibility cannot be replayed"
      },
      "required_outputs": [
        "certified_modality_switch_opportunities",
        "switch_failures",
        "switch_failure_rate",
        "switch_failure_rate_ci95",
        "counts_by_initial_target_modality"
      ],
      "permitted_wording": "The system failed to switch to a certified reachable alternate modality in at least one P23_102 development opportunity.",
      "prohibited_wording": "The model cannot perform cross-modal reasoning."
    },
    {
      "finding_id": "P23F-05-RN-RESTORATION-ITT",
      "title": "Mechanism-specific exogenous RESTORED minus NO_TRIGGER ITT effect",
      "stage_links": [
        "Acquire",
        "Ground",
        "Act"
      ],
      "eligible_records": "All preregistered assigned R/N pairs for systems declared staged before assignment; early terminals and typed invalid runs remain included.",
      "estimands": [
        "P1_RN_SILENT_ROUTE_WITHHOLDING_ITT",
        "P2_RN_EXPLICIT_CHANNEL_OUTAGE_ITT"
      ],
      "estimand_formula": "mean_paired(supported_answer_endpoint_R - supported_answer_endpoint_N)",
      "objective_decision_rule": {
        "STRUCTURALLY_INELIGIBLE": "system was frozen as non-staged before assignment",
        "INSUFFICIENT_N": "assigned_R_N_pairs < 5",
        "INTERVAL_STABLE_DESCRIPTIVE": "assigned_R_N_pairs >= 5 and rn_itt_ci95_low > 0",
        "OBSERVED_DESCRIPTIVE": "assigned_R_N_pairs >= 5 and rn_itt > 0 and rn_itt_ci95_low <= 0",
        "NOT_OBSERVED": "assigned_R_N_pairs >= 5 and rn_itt == 0",
        "ADVERSE_DESCRIPTIVE": "assigned_R_N_pairs >= 5 and rn_itt < 0",
        "INCONCLUSIVE": "R/N prefix or checkpoint integrity fails; report invalidity and do not reinterpret a per-protocol subset as primary"
      },
      "required_outputs": [
        "mechanism",
        "system_id",
        "assigned_R_N_pairs",
        "early_terminal_pairs",
        "invalid_pairs",
        "event_opportunity_reached_pairs",
        "restoration_applied_pairs",
        "restored_route_inspected_pairs",
        "complete_ses_reacquired_pairs",
        "R_supported_answer_rate",
        "N_supported_answer_rate",
        "rn_itt",
        "rn_itt_ci95"
      ],
      "permitted_wording": "For the named mechanism and staged system, the assigned P23_102 RESTORED minus NO_TRIGGER development contrast was X.",
      "prohibited_wording": "Restoration causally improves learned agents in general, a pooled silent-plus-explicit effect, or a trigger-conditioned primary estimate."
    },
    {
      "finding_id": "P23F-06-COMPLETE-VS-PARTIAL",
      "title": "Complete-versus-partial evidence unsupported completion and abstention",
      "stage_links": [
        "Ground",
        "Act"
      ],
      "eligible_records": "Same generator and family under deterministic COMPLETE_MACHINE_PROVISIONAL_SES and PROPER_PARTIAL_BREAKS_REQUIRED_CLAIM bundles selected before model execution.",
      "condition_selection": {
        "complete": "Choose the canonical complete machine-provisional SES by lexicographic immutable evidence-ID order.",
        "partial": "Remove the lexicographically first member whose registered removal breaks support for at least one required claim; if inapplicable, use the next registered member.",
        "model_visibility": "The generator receives observations but not evaluator labels or the reason for bundle selection."
      },
      "estimands": {
        "unsupported_completion_change": "mean_paired(unsupported_completion_partial - unsupported_completion_complete)",
        "abstention_change": "mean_paired(calibrated_abstention_partial - calibrated_abstention_complete)",
        "supported_answer_change": "mean_paired(supported_answer_endpoint_partial - supported_answer_endpoint_complete)"
      },
      "objective_decision_rule": {
        "INSUFFICIENT_N": "eligible_paired_families < 5",
        "OBSERVED_DESCRIPTIVE": "eligible_paired_families >= 5 and (unsupported_completion_change > 0 or abstention_change != 0)",
        "INTERVAL_STABLE_DESCRIPTIVE": "OBSERVED_DESCRIPTIVE and at least one reported paired interval excludes zero in its observed direction",
        "NOT_OBSERVED": "eligible_paired_families >= 5 and unsupported_completion_change == 0 and abstention_change == 0",
        "INCONCLUSIVE": "complete or partial bundle fails deterministic validation or is not paired for the same generator and family"
      },
      "required_outputs": [
        "eligible_paired_families",
        "unsupported_completion_rate_complete",
        "unsupported_completion_rate_partial",
        "unsupported_completion_change",
        "abstention_rate_complete",
        "abstention_rate_partial",
        "abstention_change",
        "supported_answer_rate_complete",
        "supported_answer_rate_partial",
        "invalid_count_by_condition"
      ],
      "permitted_wording": "Under machine-provisional complete versus claim-breaking partial evidence, the fixed generator changed its unsupported-completion and/or calibrated-abstention behavior on P23_102 development families.",
      "prohibited_wording": "Gold-evidence behavior, human-valid hallucination rate, or general hallucination robustness."
    },
